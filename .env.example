# Any OpenAI-compatible chat completions endpoint (OpenAI, DeepSeek, vLLM, Ollama, OpenRouter...)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
# Lighter model for the Router layer, strongest model for Workers (Section 2)
ROUTER_MODEL=deepseek-chat
WORKER_MODEL=deepseek-reasoner
WATCHDOG_MODEL=deepseek-chat
STATE_DIR=.superagent-state
